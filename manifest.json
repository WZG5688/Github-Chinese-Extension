{
  "manifest_version": 3,
  "name": "GitHub 汉化助手",
  "short_name": "GitHub 汉化",
  "version": "1.1.6",
  "description": "将 GitHub 界面文案翻译为中文，并在仓库页提供按系统匹配 Releases 安装包的悬浮下载按钮。",
  "permissions": ["storage", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://github.com/*",
    "https://gist.github.com/*",
    "https://translate.googleapis.com/*",
    "https://edge.microsoft.com/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_title": "GitHub 汉化助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://gist.github.com/*"
      ],
      "js": ["translations.js", "content.js", "release-downloader.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
